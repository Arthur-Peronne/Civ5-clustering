# ============================================================
# .env.example — copy this file to .env and fill in your paths
# .env is git-ignored and never committed to the repository
# ============================================================

# Root directory of your Civilization V Steam installation.
# Used by notebook 00 to import the raw XML leader files.
#
# Examples:
#   Linux   : /run/media/yourname/disk/steamapps/common/Sid Meier's Civilization V
#   macOS   : /Users/yourname/Library/Application Support/Steam/steamapps/common/Sid Meier's Civilization V
#   Windows : C:/Program Files (x86)/Steam/steamapps/common/Sid Meier's Civilization V
PATH_CIV5GAME=

# Root directory of this project (civ5-clustering/).
# Optional — only needed if running scripts from outside the project directory.
PATH_CLUSTER=

# Anthropic API key — required for notebook 07 (community extraction).
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=
